---
const smnAlertsUrl = "https://www.smn.gob.ar/";
---

<section class="las-lenas-home" id="las-lenas" role="region" aria-labelledby="las-lenas-title">
  <div class="las-lenas-hd">
    <div class="las-lenas-hd-left">
      <div class="las-lenas-route-row" role="group" aria-label="Rutas de acceso desde Mendoza Capital">
        <span class="las-lenas-route-pill las-lenas-route-pill--rn">RN 40</span>
        <span class="las-lenas-route-pill las-lenas-route-pill--rp">RP 222</span>
        <span class="las-lenas-route-sep" aria-hidden="true">·</span>
        <span class="las-lenas-route-distance">342 km desde Mendoza Capital</span>
      </div>
      <h2 class="las-lenas-place-title" id="las-lenas-title">Las Leñas</h2>
      <p class="las-lenas-access-note">
        Todo asfalto; en invierno hay que llevar cadenas.
      </p>
      <div class="las-lenas-place-meta">
        <span>Clima y acceso</span>
        <span class="las-lenas-meta-sep" aria-hidden="true">·</span>
        <span>Malargüe, Mendoza</span>
        <span class="las-lenas-live-badge" id="las-lenas-live" hidden aria-label="Datos en tiempo real">
          <span class="las-lenas-meta-sep" aria-hidden="true">·</span>
          <span class="las-lenas-live-dot" aria-hidden="true"></span>
          En vivo
        </span>
      </div>
    </div>
  </div>

  <div class="las-lenas-dynamic" id="las-lenas-dynamic" aria-busy="true">
    <p class="las-lenas-pending" id="las-lenas-status" aria-live="polite">
      Consultando condiciones de Las Leñas...
    </p>
  </div>

  <div class="las-lenas-alert-row">
    <svg
      class="las-lenas-alert-ico"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M12 2L1 21h22L12 2z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
      <path d="M12 9v5M12 17v.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <span class="las-lenas-alert-lbl">Alertas SMN</span>
    <a href={smnAlertsUrl} target="_blank" rel="noopener noreferrer" class="las-lenas-alert-link">
      Ver alertas oficiales →
    </a>
  </div>

  <div class="las-lenas-foot" id="las-lenas-foot" hidden></div>
</section>

<script>
  (function () {
    const ROOT_MARGIN = "500px 0px";
    const HASHES = new Set(["#las-lenas", "#las-lenas-title", "#las-lenas-pronostico"]);

    function pendingMarkup(): string {
      return `<p class="las-lenas-pending" id="las-lenas-status" aria-live="polite">Consultando condiciones de Las Leñas...</p>`;
    }

    function errorMarkup(): string {
      return `<div class="las-lenas-pending"><p id="las-lenas-status" aria-live="polite">No se pudieron consultar las condiciones de Las Leñas.</p><button type="button" class="las-lenas-retry">Reintentar</button></div>`;
    }

    function mount(root: HTMLElement) {
      if (root.dataset.lasLenasBound === "1") return;
      root.dataset.lasLenasBound = "1";

      const slotQuery = root.querySelector("#las-lenas-dynamic");
      const footQuery = root.querySelector("#las-lenas-foot");
      const live = root.querySelector("#las-lenas-live");
      if (!(slotQuery instanceof HTMLElement) || !(footQuery instanceof HTMLElement)) return;
      const slot: HTMLElement = slotQuery;
      const foot: HTMLElement = footQuery;

      let started = false;
      let observer: IntersectionObserver | null = null;

      function wantsImmediate(): boolean {
        return HASHES.has(location.hash);
      }

      function showError() {
        started = false;
        slot.setAttribute("aria-busy", "false");
        slot.innerHTML = errorMarkup();
        foot.hidden = true;
        foot.innerHTML = "";
        if (live instanceof HTMLElement) live.hidden = true;
        const retry = slot.querySelector(".las-lenas-retry");
        retry?.addEventListener("click", () => {
          slot.setAttribute("aria-busy", "true");
          slot.innerHTML = pendingMarkup();
          void request();
        });
      }

      async function request() {
        if (started) return;
        started = true;
        observer?.disconnect();
        try {
          const res = await fetch("/api/las-lenas", { headers: { Accept: "application/json" } });
          if (!res.ok) {
            showError();
            return;
          }
          const data = (await res.json()) as {
            ok?: boolean;
            weatherHtml?: string;
            footHtml?: string;
            live?: boolean;
          };
          if (!data.ok || typeof data.weatherHtml !== "string") {
            showError();
            return;
          }
          slot.setAttribute("aria-busy", "false");
          if (data.weatherHtml.trim()) {
            slot.innerHTML = data.weatherHtml;
          } else {
            slot.innerHTML = `<p class="las-lenas-pending" id="las-lenas-status">Sin datos de condición en este momento.</p>`;
          }
          if (typeof data.footHtml === "string" && data.footHtml.trim()) {
            foot.innerHTML = data.footHtml;
            foot.hidden = false;
          } else {
            foot.hidden = true;
            foot.innerHTML = "";
          }
          if (live instanceof HTMLElement) live.hidden = data.live !== true;
          if (location.hash === "#las-lenas-pronostico") {
            document.getElementById("las-lenas-pronostico")?.scrollIntoView({ block: "nearest" });
          }
        } catch {
          showError();
        }
      }

      if (wantsImmediate()) {
        void request();
      } else if ("IntersectionObserver" in window) {
        observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) void request();
          },
          { rootMargin: ROOT_MARGIN },
        );
        observer.observe(root);
        window.addEventListener("hashchange", () => {
          if (wantsImmediate()) void request();
        });
      } else {
        void request();
      }
    }

    function init() {
      document.querySelectorAll<HTMLElement>(".las-lenas-home").forEach(mount);
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
