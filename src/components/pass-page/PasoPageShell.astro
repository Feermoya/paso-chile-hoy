---
import { Icon } from "astro-icon/components";
import { PASOS } from "@/data/pasos";
import AguaNegraAntesDeCruzar from "@/components/pass-page/AguaNegraAntesDeCruzar.astro";
import PasoFullwidthSection from "@/components/pass-page/PasoFullwidthSection.astro";
import PasoOperationalSection from "@/components/pass-page/PasoOperationalSection.astro";
import PasoWeatherSection from "@/components/pass-page/PasoWeatherSection.astro";
import type { ExtendedForecastSignal } from "@/lib/external/mendozaExtendedForecast";
import type { CristoRedentorRiskV1 } from "@/types/cristo-redentor-risk-v1";
import type { ForecastItemView, PassView, WeatherNowView } from "@/types/pass-view";
import type { PassStatusResult } from "@/utils/inferPassStatus";

export interface Props {
  slug: string;
  view: PassView;
  statusResult: PassStatusResult;
  scheduleText: string;
  lastUpdatedRelative: string;
  officialUrl?: string;
  lastKnownGoodRelative?: string;
  now?: WeatherNowView;
  forecast: ForecastItemView[];
  showNow: boolean;
  showForecast: boolean;
  hideScheduleInDetails: boolean;
  /** Solo Cristo Redentor — motor v1 de riesgo informativo. */
  cristoRisk?: CristoRedentorRiskV1;
  /** Solo Cristo — señal boletín extendido (Prensa Mendoza). */
  extendedForecastSignal?: ExtendedForecastSignal;
  class?: string;
}

const {
  slug,
  view,
  statusResult,
  scheduleText,
  lastUpdatedRelative,
  officialUrl,
  lastKnownGoodRelative,
  now,
  forecast,
  showNow,
  showForecast,
  hideScheduleInDetails,
  cristoRisk,
  extendedForecastSignal,
  class: className,
} = Astro.props;
const otherPasses = PASOS.filter((paso) => paso.active && paso.slug !== slug);
---

<div
  class:list={["paso-page-shell paso-page-wrapper", className]}
  data-paso-page-shell
  data-shell-slug={slug}
>
  <div
    id={`paso-stale-banner-${slug}`}
    class="paso-stale-banner mb-3 hidden rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)] px-3 py-2 text-[13px] leading-snug text-[var(--color-text-secondary)]"
    role="status"
    aria-live="polite"
  />
  <div class="paso-page-grid paso-grid">
    <PasoOperationalSection
      slug={slug}
      view={view}
      statusResult={statusResult}
      scheduleText={scheduleText}
      lastUpdatedRelative={lastUpdatedRelative}
      officialUrl={officialUrl}
      lastKnownGoodRelative={lastKnownGoodRelative}
      cristoRisk={cristoRisk}
      extendedForecastSignal={extendedForecastSignal}
    />

    <PasoWeatherSection
      slug={slug}
      passName={view.title}
      sourceUrl={view.meta.sourceUrl}
      now={now}
      forecast={forecast}
      scrapedAt={view.meta.scrapedAt}
      showNow={showNow}
      showForecast={showForecast}
      cristoRisk={cristoRisk}
      cordilleraStations={extendedForecastSignal?.cordilleraStations}
    />
  </div>

  {slug === "agua-negra" && <AguaNegraAntesDeCruzar />}

  {otherPasses.length > 0 && (
    <section class="paso-other-crossings" aria-labelledby="other-crossings-heading">
      <h2 id="other-crossings-heading">Otros pasos a Chile</h2>
      <p>Compará el estado, los horarios y el clima de otros cruces antes de decidir tu ruta.</p>
      <ul class="paso-other-crossings__list">
        {otherPasses.map((paso) => (
          <li>
            <a class="paso-other-crossings__link" href={`/${paso.slug}`}>
              <span>
                <strong>Paso {paso.shortName}</strong>
                <small>{paso.localityAR} · {paso.localityCL}</small>
              </span>
              <Icon name="lucide:chevron-right" width="18" height="18" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <PasoFullwidthSection
    view={view}
    hideScheduleInDetails={hideScheduleInDetails}
    hideOfficialLink={Boolean(officialUrl?.trim())}
  />
</div>

<script is:inline define:vars={{ slug }}>
  function showStaleRefreshBanner() {
    const key = `pch:pass-stale-banner:${slug}`;
    const msg = sessionStorage.getItem(key);
    if (!msg) return;
    sessionStorage.removeItem(key);
    const el = document.getElementById(`paso-stale-banner-${slug}`);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove("hidden");
  }

  showStaleRefreshBanner();
  document.addEventListener("astro:page-load", showStaleRefreshBanner);

  function syncPasoSections() {
    var nav = document.querySelector(".paso-section-nav");
    if (!nav) return;
    var hash = window.location.hash;
    var links = nav.querySelectorAll("a");
    for (var i = 0; i < links.length; i++) {
      var link = links[i];
      var active = hash ? link.getAttribute("href") === hash : link.getAttribute("href") === "#estado";
      if (active) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  }

  syncPasoSections();
  window.addEventListener("hashchange", syncPasoSections);
  document.addEventListener("astro:page-load", syncPasoSections);
</script>
