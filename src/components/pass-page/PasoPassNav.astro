---
import { Icon } from "astro-icon/components";
import type { PasoConfig } from "@/data/pasos";

export interface Props {
  paso: PasoConfig;
  class?: string;
}

const { paso, class: className } = Astro.props;
const routeLine = `${paso.localityAR} — ${paso.localityCL}`;
---

<div class:list={["paso-pass-nav", className]}>
  <div class="paso-cover" aria-hidden="true"></div>
  <button type="button" class="paso-cover-share" aria-label={`Compartir ${paso.shortName}`}>
    <Icon name="lucide:share" width="18" height="18" aria-hidden="true" />
  </button>
  <nav aria-label="Ubicación en el sitio">
  <ol class="paso-pass-nav__crumbs">
    <li>
      <a href="/" class="paso-pass-nav__link">
        <Icon name="lucide:arrow-left" class="paso-cover-back-icon" width="18" height="18" aria-hidden="true" />
        <span>Inicio</span>
      </a>
    </li>
    <li class="paso-pass-nav__sep" aria-hidden="true">
      <Icon name="lucide:chevron-right" class="paso-pass-nav__chev" />
    </li>
    <li>
      <h1 class="paso-pass-nav__current" aria-current="page">
        <span class="paso-pass-mark" aria-hidden="true">
          <Icon name="lucide:mountain" width="22" height="22" />
        </span>
        {paso.shortName}
      </h1>
    </li>
  </ol>
  </nav>
  <p class="paso-pass-nav__route">{routeLine} · {paso.provinceAR}</p>
  <nav class="paso-section-nav" aria-label="Secciones del paso">
    <a href="#estado" data-paso-section-link>Estado</a>
    <a href="#clima" data-paso-section-link>Clima</a>
    <a href="#informacion" data-paso-section-link>Información</a>
  </nav>
</div>

<script>
  function wirePassShare(root: ParentNode) {
    root.querySelectorAll(".paso-cover-share").forEach((node) => {
      if (!(node instanceof HTMLButtonElement) || node.dataset.shareWired === "1") return;
      node.dataset.shareWired = "1";
      node.addEventListener("click", async () => {
        const title =
          document.querySelector(".paso-pass-nav__current")?.textContent?.replace(/\s+/g, " ").trim() ||
          document.title;
        const url = window.location.href;
        if (typeof navigator.share === "function") {
          try {
            await navigator.share({ title, url });
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") return;
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          node.setAttribute("aria-label", "Enlace copiado");
        } catch {
          node.setAttribute("aria-label", "No se pudo compartir");
        }
      });
    });
  }

  wirePassShare(document);
  document.addEventListener("astro:page-load", () => wirePassShare(document));
</script>
