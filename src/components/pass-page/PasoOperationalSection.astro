---
import AlertsBlock from "@/components/AlertsBlock.astro";
import LatestTweet from "@/components/LatestTweet.astro";
import CristoRiskCard from "@/components/pass/CristoRiskCard.astro";
import PanoramaExtendido from "@/components/pass/PanoramaExtendido.astro";
import StatusHero from "@/components/StatusHero.astro";
import TwitterAlerts from "@/components/TwitterAlerts.astro";
import { Icon } from "astro-icon/components";
import type { ExtendedForecastSignal } from "@/lib/external/mendozaExtendedForecast";
import type { CristoRedentorRiskV1 } from "@/types/cristo-redentor-risk-v1";
import type { PassView } from "@/types/pass-view";
import type { PassStatusResult } from "@/utils/inferPassStatus";
import { formatHeroSchedule } from "@/utils/formatHeroSchedule";
import { buildOperationalNotices } from "@/utils/operationalNotices";
import { assessSnapshotFreshness } from "@/utils/snapshotFreshness";

export interface Props {
  slug: string;
  view: PassView;
  statusResult: PassStatusResult;
  scheduleText: string;
  lastUpdatedRelative: string;
  officialUrl?: string;
  lastKnownGoodRelative?: string;
  cristoRisk?: CristoRedentorRiskV1;
  extendedForecastSignal?: ExtendedForecastSignal;
  class?: string;
}

const {
  slug,
  view,
  statusResult,
  scheduleText,
  lastUpdatedRelative,
  officialUrl,
  lastKnownGoodRelative,
  cristoRisk,
  extendedForecastSignal,
  class: className,
} = Astro.props;

const op = view.operationalInfo;
const latestTweet = view.meta?.latestTweet;
const showLatestTweet = Boolean(latestTweet?.text && latestTweet.text.trim().length >= 10);
const statusDisplayLabel = statusResult.displayLabel?.trim() || "";
const operationalNotices = buildOperationalNotices({
  motivo: op.motivo ?? null,
  motivoInfo: op.motivoInfo ?? null,
  htmlAlerts: op.htmlAlerts,
  vialidadRuta: op.vialidadRuta ?? "",
  vialidadTramo: op.vialidadTramo ?? "",
  vialidadEstado: op.vialidadEstado ?? "HABILITADA",
  vialidadObservaciones: op.vialidadObservaciones ?? "",
  statusDisplayLabel,
});
const hasOperationalNotices = operationalNotices.length > 0;
const showCristoExtras = slug === "cristo-redentor" && (cristoRisk || extendedForecastSignal);
const showDetailPanel = hasOperationalNotices || showCristoExtras || showLatestTweet;
const freshness = assessSnapshotFreshness(view.meta.scrapedAt);
const showLiveBadge = freshness.level === "fresh" && view.meta.operationalStale !== true;
const scheduleDisplay = formatHeroSchedule(scheduleText);
const scheduleValue = [scheduleDisplay?.primary, scheduleDisplay?.detail].filter(Boolean).join(" · ");
const routeBits = [
  op.vialidadRuta?.trim() ? `RN ${op.vialidadRuta.trim()}` : "",
  op.vialidadTramo?.trim() ?? "",
].filter(Boolean);
const routeValue = routeBits.join(", ") || view.location.routeDescription?.trim() || "";
const localityValue = [view.location.localityArgentina, view.location.localityBorder]
  .map((part) => part?.trim())
  .filter(Boolean)
  .join(" — ");
---

<section
  id="estado"
  class:list={["paso-page-operational paso-col", className]}
  aria-label="Estado operativo"
>
  <StatusHero
    class="anim-section anim-delay-1"
    slug={slug}
    status={statusResult.status}
    displayLabel={statusResult.displayLabel}
    passName={view.title}
    schedule={scheduleText}
    lastUpdatedRelative={lastUpdatedRelative}
    officialUrl={officialUrl}
    opensInMinutes={statusResult.opensInMinutes}
    closesInMinutes={statusResult.closesInMinutes}
    rawStatus={op.rawStatus}
    scrapeError={view.meta.scrapeError}
    operationalStale={view.meta.operationalStale}
    lastKnownGoodRelative={lastKnownGoodRelative}
    compactOfficialLink
    showLiveBadge={showLiveBadge}
  />

  {
    showDetailPanel && (
      <div class="paso-panel paso-extra-details anim-section anim-delay-2" aria-label="Complementos del cruce">
        <div class="paso-panel__head">
          <h2 class="paso-panel__title">
            <Icon name="lucide:clipboard-list" class="paso-detail-heading-icon" width="18" height="18" aria-hidden="true" />
            Detalle operativo
          </h2>
        </div>
        <div class="paso-panel__body paso-extra-details__body">
          {slug === "cristo-redentor" && cristoRisk && <CristoRiskCard risk={cristoRisk} />}

          {
            slug === "cristo-redentor" && extendedForecastSignal && (
              <PanoramaExtendido signal={extendedForecastSignal} />
            )
          }

          <AlertsBlock
            motivo={op.motivo ?? null}
            motivoInfo={op.motivoInfo ?? null}
            htmlAlerts={op.htmlAlerts}
            vialidadRuta={op.vialidadRuta ?? ""}
            vialidadTramo={op.vialidadTramo ?? ""}
            vialidadEstado={op.vialidadEstado ?? "HABILITADA"}
            vialidadObservaciones={op.vialidadObservaciones ?? ""}
            statusDisplayLabel={statusDisplayLabel}
          />

          {showLatestTweet && <LatestTweet tweet={latestTweet} />}
        </div>
      </div>
    )
  }

  <section class="paso-fact-sheet" aria-label="Datos del cruce">
    {
      scheduleValue && (
        <div class="paso-fact-row">
          <Icon name="lucide:clock" width="18" height="18" aria-hidden="true" />
          <span class="paso-fact-label">Horario</span>
          <span class="paso-fact-value">{scheduleValue}</span>
        </div>
      )
    }
    {
      routeValue && (
        <div class="paso-fact-row">
          <Icon name="lucide:route" width="18" height="18" aria-hidden="true" />
          <span class="paso-fact-label">Ruta</span>
          <span class="paso-fact-value">{routeValue}</span>
        </div>
      )
    }
    {
      localityValue && (
        <div class="paso-fact-row">
          <Icon name="lucide:map-pin" width="18" height="18" aria-hidden="true" />
          <span class="paso-fact-label">Localidades</span>
          <span class="paso-fact-value">{localityValue}</span>
        </div>
      )
    }
    <a class="paso-fact-row" href="/#status-guide">
      <Icon name="lucide:info" width="18" height="18" aria-hidden="true" />
      <span class="paso-fact-label">Estados y alertas</span>
      <span class="paso-fact-value">Cómo leer abierto, cerrado y alertas de ruta</span>
      <Icon name="lucide:chevron-right" class="paso-fact-chevron" width="16" height="16" aria-hidden="true" />
    </a>
  </section>

  <div class="paso-social-footer anim-section anim-delay-3">
    <TwitterAlerts passSlug={slug} />
    <a href="/#status-guide" class="paso-legend-link">
      <Icon name="lucide:info" class="h-4 w-4 shrink-0 opacity-70" aria-hidden="true" />
      Cómo leer abierto, cerrado y alertas de ruta
    </a>
  </div>
</section>

<style>
  .paso-social-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 2px 0 0;
  }
</style>
